# 所有文件的基础约定（见 https://editorconfig.org）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,mjs,cjs,json,jsonc,yml,yaml,css,html}]
indent_size = 2

[*.{kt,kts,gradle,java}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2
