{
  "name": "minesweeper",
  "version": "1.3.0",
  "description": "经典扫雷游戏 · Classic Minesweeper (Electron desktop + Android)",
  "main": "main.js",
  "license": "MIT",
  "author": "w-PiaoPiao",
  "homepage": "https://github.com/w-PiaoPiao/saolei#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/w-PiaoPiao/saolei"
  },
  "bugs": {
    "url": "https://github.com/w-PiaoPiao/saolei/issues"
  },
  "keywords": [
    "minesweeper",
    "扫雷",
    "electron",
    "game",
    "kotlin",
    "android"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write \"scripts/**/*.mjs\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"*.json\"",
    "check-version": "node scripts/check-version.mjs",
    "clean": "bash scripts/clean.sh",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.minesweeper.app",
    "productName": "扫雷",
    "artifactName": "minesweeper-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "src/**/*",
      "LICENSE"
    ],
    "asarUnpack": [
      "src/generator-worker.js",
      "src/generator.js",
      "src/solver.js",
      "src/config.js",
      "src/neighbors.js"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.puzzle-games"
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.4",
    "prettier": "^3.9.10"
  }
}
