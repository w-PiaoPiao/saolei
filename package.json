{
  "name": "minesweeper",
  "version": "1.2.0",
  "description": "经典扫雷游戏",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/w-PiaoPiao/saolei"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.minesweeper.app",
    "productName": "扫雷",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "src/**/*"
    ],
    "asarUnpack": [
      "src/generator-worker.js",
      "src/generator.js",
      "src/solver.js",
      "src/config.js"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
